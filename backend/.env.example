DATABASE_URL="postgresql://postgres:postgres@localhost:5432/immopilot?schema=public"
# Tests Jest (recommandé : base dédiée locale, jamais Neon). Si vide, pretest retombe sur DATABASE_URL.
# DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/immopilot_test?schema=public"
# Secret JWT (sessions) : en prod, chaîne longue aléatoire unique.
JWT_SECRET="changez-moi-en-production-long-secret-aleatoire"
PORT=4000
# Dossier parent des fichiers (sous-dossier lease-contracts créé automatiquement). Défaut : uploads à la racine du backend.
# LEASE_CONTRACT_UPLOAD_SUBDIR=uploads
# Stockage : local (dev) | s3 (R2 / Backblaze / AWS). Prod : S3 recommandé.
# STORAGE_DRIVER=local
# STORAGE_ALLOW_LOCAL=true
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# S3_KEY_PREFIX=immopilot
# Liens quittance publics (heures). Défaut 720 = 30 jours.
# RECEIPT_SHARE_TTL_HOURS=720
# Bootstraps SQL runtime (transition) : false après migrate deploy en prod.
# ENABLE_SCHEMA_BOOTSTRAP=true
# AUTH_LOCKOUT_MAX_FAILURES=5
# AUTH_LOCKOUT_BASE_MS=30000
# Observabilité (optionnel) — absent = Sentry désactivé
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Production : origines autorisées (séparées par des virgules), ex. https://app.mondomaine.ci
# Développement : laisser vide → localhost / 127.0.0.1 (tous ports) + IP LAN 192.168.x.x / 10.x.x.x
# FRONTEND_ORIGIN="http://localhost:5173,https://mon-app.com"
FRONTEND_ORIGIN=
# URL publique du front (liens « mot de passe oublié », relances). Local : http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# PUBLIC_APP_URL="https://app.mondomaine.ci"
# Face ID / passkeys (WebAuthn) — domaine du FRONT (pas de l’API).
# En local : laisser vide → dérivé de PUBLIC_APP_URL (localhost).
# En prod : hostname de l’app, ex. app.mondomaine.ci
# WEBAUTHN_RP_ID=app.mondomaine.ci
# WEBAUTHN_ORIGIN=https://app.mondomaine.ci
# WEBAUTHN_RP_NAME=ImmoPilot
# URL publique de l’API (liens quittance WhatsApp). En prod Render : https://immopilot-api.onrender.com
# PUBLIC_API_URL=http://localhost:4000
# PUBLIC_API_URL=https://immopilot-api.onrender.com
SEED_ADMIN_EMAIL="admin@immopilot.local"
SEED_ADMIN_PASSWORD="AdminImmo2026!"
# Après `npx prisma migrate deploy` + `npm run seed` : ce compte a le rôle PLATFORM_ADMIN (menu « Créer un client »).
# Base déjà peuplée sans seed : UPDATE "User" SET role = 'PLATFORM_ADMIN' WHERE email = 'votre@admin.com';
# Données de démo (Abidjan, Bassam…) si la base est vide : laisser vide ou 1
# SEED_DEMO_DATA=0 pour désactiver
# SEED_DEMO_FORCE=1 pour effacer biens/locations et recréer la démo

# ---------- E-mails de relance (Paiements / Tableau de bord) ----------
# Sans SMTP : ne rien mettre dans SMTP_HOST → le mail est seulement affiché dans la console API.
# Forcer toujours la simulation : MAIL_MODE=log
#
# Exemple Gmail :
#   MAIL_MODE=smtp
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=votrecompte@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx   (mot de passe d'application Google, pas le mot de passe du compte)
#   MAIL_FROM="ImmoPilot <votrecompte@gmail.com>"
#
# Exemple Outlook / Office 365 :
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=vous@outlook.com
#
# Enregistrer ce fichier en UTF-8 (pas « Unicode » / UTF-16 sous Windows), sinon les variables SMTP sont ignorées.
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Test d’envoi : npm run test:smtp [email_destinataire]
# Gmail : SMTP_PASS = mot de passe d’application (16 caractères), pas le mot de passe du compte.
