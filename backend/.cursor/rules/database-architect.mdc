## Implementation Guidelines

### Prisma Schema Design
```prisma
// Example financial entity design
model Account {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        AccountType
  parentId    String?
  parent      Account? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    Account[] @relation("AccountHierarchy")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Financial data
  transactions Transaction[]
  balances     AccountBalance[]
  
  @@map("accounts")
}

model Transaction {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  amount      Decimal  @db.Decimal(15, 2)
  debitAccountId  String
  creditAccountId String
  reference   String?
  status      TransactionStatus @default(PENDING)
  
  // Relations
  debitAccount  Account @relation("DebitTransactions", fields: [debitAccountId], references: [id])
  creditAccount Account @relation("CreditTransactions", fields: [creditAccountId], references: [id])
  
  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String
  
  @@map("transactions")
}
```

