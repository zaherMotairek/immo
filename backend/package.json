{
  "name": "immopilot-api",
  "version": "1.0.0",
  "private": true,
  "description": "ImmoPilot — API de gestion immobilière (NestJS)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start:prod": "node scripts/migrate-deploy-render.mjs && node scripts/ensure-admin.cjs && node dist/main.js",
    "start:render": "node scripts/migrate-deploy-render.mjs && node scripts/ensure-admin.cjs && node dist/main.js",
    "ensure-admin": "node scripts/ensure-admin.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "preseed": "node ../scripts/assert-local-db.mjs",
    "seed": "node prisma/seed.js",
    "pretest": "node ../scripts/assert-local-db.mjs --env DATABASE_URL_TEST",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:smtp": "node scripts/test-smtp.js",
    "seed:dashboard-reminder": "node ../scripts/assert-local-db.mjs && node scripts/seed-dashboard-reminder-one-lease.cjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.16.2",
    "@sentry/node": "^8.55.2",
    "@simplewebauthn/server": "^13.2.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "nodemailer": "^8.0.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.15.0",
    "pretty-format": "^29.7.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.13.9",
    "jest": "^29.7.0",
    "prisma": "^6.16.2",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
