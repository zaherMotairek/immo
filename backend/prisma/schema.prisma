generator client {
  provider   = "prisma-client-js"
  /** Moteur en binaire : souvent moins de verrouillage fichier (EPERM) sous Windows que la DLL. */
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/** Cloisonnement : chaque client (cabinet / propriétaire) a ses propres biens et locataires. */
model Organization {
  id        String   @id @default(uuid())
  name      String?
  /** Dernier jour d’accès inclus pour les comptes « client » (hors admin plateforme). Vide = pas de blocage par date. */
  platformAccessPaidUntil DateTime? @map("platform_access_paid_until") @db.Date
  /** Blocage manuel par l’admin plateforme (prioritaire). */
  platformAccessSuspended Boolean @default(false) @map("platform_access_suspended")
  /**
   * Automation opt-in (Phase C) : échéances auto, relances, templates…
   * Voir `OrgAutomationSettings` côté code.
   */
  automationSettings Json? @map("automation_settings")
  /** Phase D : code plan (FREE / TRIAL / PRO…). */
  planCode String @default("PRO") @map("plan_code")
  trialEndsAt DateTime? @map("trial_ends_at") @db.Date
  /** Fin d’abonnement payant (synchro / miroir de platformAccessPaidUntil en transition). */
  subscriptionEndsAt DateTime? @map("subscription_ends_at") @db.Date
  lastLoginAt DateTime? @map("last_login_at")
  internalNotes String? @map("internal_notes") @db.Text
  isDemo Boolean @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users     User[]
  buildings Building[]
  tenants   Tenant[]
  reminderOutbox ReminderOutbox[]
  subscriptionPayments SubscriptionPayment[]
  planChangeLogs PlanChangeLog[]
  inspectionTemplates InspectionChecklistTemplate[]
  leaseInspections      LeaseInspection[]
  repairRequests        RepairRequest[]

  @@map("organizations")
}

/** Catalogue des plans (D1). */
model Plan {
  code              String  @id
  name              String
  unitLimit         Int?    @map("unit_limit")
  userLimit         Int?    @map("user_limit")
  features          Json?
  monthlyPriceFcfa  Int     @map("monthly_price_fcfa")
  active            Boolean @default(true)

  @@map("plans")
}

enum SubscriptionPaymentMethod {
  WAVE
  ORANGE
  MTN
  MOOV
  CASH
  BANK
}

model SubscriptionPayment {
  id               String                     @id @default(uuid())
  organizationId   String                     @map("organization_id")
  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amountFcfa       Int                        @map("amount_fcfa")
  method           SubscriptionPaymentMethod
  reference        String?                    @db.VarChar(120)
  paidAt           DateTime                   @map("paid_at") @db.Date
  periodStart      DateTime                   @map("period_start") @db.Date
  periodEnd        DateTime                   @map("period_end") @db.Date
  recordedByUserId String?                    @map("recorded_by_user_id")
  note             String?                    @db.VarChar(500)
  /** D6 : mois prépayés (1 / 3 / 12) — UI manuelle ; provider en ligne plus tard. */
  prepaidMonths    Int?                       @map("prepaid_months")
  /** Réservé branchement CinetPay / Wave API (null = saisie manuelle admin). */
  provider         String?                    @db.VarChar(40)
  providerRef      String?                    @map("provider_ref") @db.VarChar(120)
  createdAt        DateTime                   @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("subscription_payments")
}

model PlanChangeLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromPlanCode   String?  @map("from_plan_code")
  toPlanCode     String   @map("to_plan_code")
  actorUserId    String?  @map("actor_user_id")
  note           String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("plan_change_logs")
}

enum UserRole {
  USER
  /** Compte interne : création d’organisations / comptes clients (back-office). */
  PLATFORM_ADMIN
}

/** F1 — rôle métier dans l’organisation (indépendant de PLATFORM_ADMIN). */
enum OrgMemberRole {
  OWNER
  ACCOUNTANT
  COLLECTOR
  READONLY
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String               @map("password_hash")
  name                String?
  role                UserRole             @default(USER)
  /** F1 : droits intra-org (grandfather OWNER). */
  orgRole             OrgMemberRole        @default(OWNER) @map("org_role")
  organizationId      String               @map("organization_id")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /** D3 : désactivation compte (login bloqué). */
  deactivatedAt       DateTime?            @map("deactivated_at")
  /** D5 : e-mail vérifié (inscription). */
  emailVerifiedAt     DateTime?            @map("email_verified_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  webauthnCredentials WebAuthnCredential[]
  webauthnChallenges  WebAuthnChallenge[]

  @@index([organizationId])
}

/** D5 : vérification e-mail à l’inscription. */
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

/** Clé Face ID / empreinte / passkey (WebAuthn) liée à un compte. */
model WebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Identifiant credential en base64url. */
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  deviceType   String?   @map("device_type")
  backedUp     Boolean   @default(false) @map("backed_up")
  /** Transports WebAuthn sérialisés JSON (ex. ["internal"]). */
  transports   String?
  friendlyName String?   @map("friendly_name")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  @@index([userId])
  @@map("webauthn_credentials")
}

/** Challenge WebAuthn temporaire (enregistrement ou connexion). */
model WebAuthnChallenge {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String?
  challenge String
  purpose   String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@map("webauthn_challenges")
}

/** Jeton à usage unique pour le lien « mot de passe oublié » (expiration courte). */
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum BuildingStructureKind {
  /** Plusieurs unités / plusieurs baux (ex. immeuble d’appartements, bâtiment découpé en lots). */
  IMMEUBLE
  /** Même terrain cadastral découpé en plusieurs lots / locataires / baux (parcelles, emplacements, etc.). */
  TERRAIN_LOTS
  /** Un seul lot louable sur le bien (villa, entrepôt entier, bureau entier, parcelle unique, etc.). */
  MONO_LOT
}

model Building {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  city           String
  commune        String
  address        String?
  postalCode     String?                @map("postal_code")
  country        String                 @default("Côte d'Ivoire")
  notes          String?
  structureKind  BuildingStructureKind  @default(MONO_LOT) @map("structure_kind")
  /** Nombre d’étages du bâtiment (immeuble) — indicatif. */
  floorCount     Int?                   @map("floor_count")
  /** Immeuble : le rez-de-chaussée (étage 0) compte dans les étages. Si false, étages 1…floorCount seulement. */
  hasRezDeChaussee Boolean?            @map("has_rez_de_chaussee")
  /** Nombre total de logements d’habitation à numéroter sur l’immeuble (1…N). */
  apartmentCount Int?                   @map("apartment_count")
  /**
   * Immeuble : même nombre de logements d’habitation sur chaque étage ≥ 1 (numéros 1…N par étage).
   * Null = ancienne numérotation globale 1…apartmentCount sur tout le bien.
   */
  apartmentsPerFloor Int?              @map("apartments_per_floor")
  /** Plafond d’unités d’habitation au rez-de-chaussée. Null/0 = pas de logement habitable au RDC. */
  rezApartmentCount Int?               @map("rez_apartment_count")
  /** Plafond optionnel pour numéros entrepôt / commerce (distinct des logements). */
  locauxSlotCount Int?                 @map("locaux_slot_count")
  /** Nombre de lots prévus sur le terrain (terrain multi locataires) — indicatif. */
  terrainLotCount Int?                 @map("terrain_lot_count")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  units          Unit[]
  charges        Charge[]
  repairRequests RepairRequest[]

  @@index([organizationId])
  @@map("buildings")
}

enum UnitKind {
  APARTMENT
  HOUSE
  LAND
  OFFICE
  WAREHOUSE
  COMMERCIAL
  GARAGE
  OTHER
}

model Unit {
  id            String   @id @default(uuid())
  buildingId    String   @map("building_id")
  label         String
  kind          UnitKind @default(APARTMENT)
  floor         Int?
  /** Numéro de logement (1…apartmentCount), pour logements d’habitation en immeuble. */
  apartmentSlot Int?     @map("apartment_slot")
  /** Numéro de local pro (1…locauxSlotCount si plafond défini), pour WAREHOUSE et COMMERCIAL en immeuble. */
  locauxSlot   Int?     @map("locaux_slot")
  surfaceM2     Decimal? @map("surface_m2") @db.Decimal(10, 2)
  rooms         Int?
  defaultRent   Decimal? @map("default_rent") @db.Decimal(12, 2)
  description   String?
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  building      Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  leases        Lease[]
  charges       Charge[]
  repairRequests RepairRequest[]

  @@unique([buildingId, locauxSlot])
  @@index([buildingId])
  @@map("units")
}

model Tenant {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String?
  phone     String?
  notes     String?
  /** Scan CNI, passeport, etc. (fichier sur disque, clé dans id_doc_file_key). */
  idDocOriginalName String?   @map("id_doc_original_name")
  idDocMime         String?   @map("id_doc_mime")
  idDocSize         Int?      @map("id_doc_size")
  idDocFileKey      String?   @map("id_doc_file_key")
  idDocUploadedAt   DateTime? @map("id_doc_uploaded_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  leases    Lease[]

  @@index([organizationId])
  @@map("tenants")
}

model Lease {
  id            String    @id @default(uuid())
  unitId        String    @map("unit_id")
  tenantId      String    @map("tenant_id")
  startDate     DateTime  @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  monthlyRent   Decimal   @map("monthly_rent") @db.Decimal(12, 2)
  depositAmount Decimal?  @map("deposit_amount") @db.Decimal(12, 2)
  /** Date à laquelle la caution / dépôt de garantie a été encaissée (suivi métier). */
  depositPaidAt DateTime? @map("deposit_paid_at") @db.Date
  rentDueDay    Int       @default(1) @map("rent_due_day")
  active        Boolean   @default(true)
  /** Nom du fichier tel qu’envoyé par l’utilisateur (PDF ou image). */
  contractFileOriginalName String?   @map("contract_file_original_name")
  contractFileMime         String?   @map("contract_file_mime")
  contractFileSize         Int?      @map("contract_file_size")
  /** Nom du fichier sur disque (UUID + extension), sous uploads/lease-contracts. */
  contractFileKey          String?   @map("contract_file_key")
  contractUploadedAt       DateTime? @map("contract_uploaded_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  unit          Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payments      Payment[]
  rentRevisions LeaseRentRevision[]
  inspections   LeaseInspection[]

  @@index([unitId])
  @@index([tenantId])
  @@map("leases")
}

/** C6-A : historique des révisions de loyer (amendement). */
model LeaseRentRevision {
  id            String   @id @default(uuid())
  leaseId       String   @map("lease_id")
  lease         Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime @map("effective_from") @db.Date
  previousRent  Decimal  @map("previous_rent") @db.Decimal(12, 2)
  newRent       Decimal  @map("new_rent") @db.Decimal(12, 2)
  percent       Decimal? @db.Decimal(8, 4)
  note          String?  @db.VarChar(500)
  createdByUserId String? @map("created_by_user_id")
  /** Si true : endDate a été prolongée dans la même opération. */
  renewed       Boolean  @default(false)
  newEndDate    DateTime? @map("new_end_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([leaseId])
  @@map("lease_rent_revisions")
}

enum PaymentStatus {
  PENDING
  PAID
  LATE
  CANCELLED
  /** Loyer offert (geste commercial) — pas d’encaissement, montant dû conservé pour l’audit. */
  WAIVED
}

/** Mode d’encaissement saisi à la main (pas d’intégration bancaire). */
enum CollectionMethod {
  CASH
  BANK_TRANSFER
  ORANGE_MONEY
  MTN_MONEY
  MOOV
  WAVE
  OTHER
}

enum ReminderChannel {
  EMAIL
  WHATSAPP
}

model Payment {
  id          String        @id @default(uuid())
  leaseId     String        @map("lease_id")
  periodYear  Int           @map("period_year")
  periodMonth Int           @map("period_month")
  amountDue   Decimal       @map("amount_due") @db.Decimal(12, 2)
  dueDate     DateTime      @map("due_date") @db.Date
  paidAt      DateTime?     @map("paid_at")
  amountPaid  Decimal?      @map("amount_paid") @db.Decimal(12, 2)
  status      PaymentStatus @default(PENDING)
  notes       String?
  /** Motif obligatoire si status = WAIVED (traçabilité). */
  waiveReason String?       @map("waive_reason")
  waivedAt    DateTime?     @map("waived_at") @db.Date
  /** Comment le loyer a été reçu (espèces, Mobile Money, etc.) — saisie manuelle. */
  collectionMethod    CollectionMethod? @map("collection_method")
  /** Référence opérateur, n° de versement, libellé virement… */
  collectionReference String?           @map("collection_reference") @db.VarChar(120)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  lease       Lease         @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  reminders   PaymentReminder[]
  reminderOutbox ReminderOutbox[]

  @@unique([leaseId, periodYear, periodMonth])
  @@index([leaseId])
  @@index([dueDate])
  @@index([status])
  @@map("payments")
}

/** Historique des relances (e-mail automatique ou WhatsApp noté à la main). */
model PaymentReminder {
  id        String          @id @default(uuid())
  paymentId String          @map("payment_id")
  payment   Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  channel   ReminderChannel
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([paymentId])
  @@map("payment_reminders")
}

enum ReminderOutboxStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

/** File d’attente des relances automatiques (idempotente par payment+channel+offset). */
model ReminderOutbox {
  id              String               @id @default(uuid())
  organizationId  String               @map("organization_id")
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentId       String               @map("payment_id")
  payment         Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  channel         ReminderChannel
  ruleOffsetDays  Int                  @map("rule_offset_days")
  tone            String?              @db.VarChar(32)
  status          ReminderOutboxStatus @default(QUEUED)
  bodyPreview     String?              @map("body_preview") @db.Text
  waMeUrl         String?              @map("wa_me_url") @db.VarChar(512)
  errorMessage    String?              @map("error_message") @db.VarChar(500)
  scheduledFor    DateTime             @map("scheduled_for")
  processedAt     DateTime?            @map("processed_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@unique([paymentId, channel, ruleOffsetDays])
  @@index([organizationId, status])
  @@index([scheduledFor, status])
  @@map("reminder_outbox")
}

enum ChargeCategory {
  TAX
  FEES
  INSURANCE
  MAINTENANCE
  UTILITIES
  /** Gardiennage, vigile, société de sécurité, contrôle d’accès… */
  SECURITY
  /** Salaires et charges sociales : concierge, agent d’entretien, personnel de l’immeuble… */
  PAYROLL
  OTHER
}

model Charge {
  id          String         @id @default(uuid())
  buildingId  String         @map("building_id")
  unitId      String?        @map("unit_id")
  category    ChargeCategory
  label       String
  amount      Decimal        @db.Decimal(12, 2)
  periodYear  Int            @map("period_year")
  periodMonth Int?           @map("period_month")
  paid        Boolean        @default(false)
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  building    Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unit        Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  repairRequest RepairRequest?

  @@index([buildingId])
  @@index([periodYear])
  @@map("charges")
}

// ——— Phase G : états des lieux & réparations ———

enum InspectionKind {
  MOVE_IN
  MOVE_OUT
}

enum InspectionItemCondition {
  GOOD
  WORN
  DAMAGED
  UNCHECKED
}

enum InspectionStatus {
  DRAFT
  SIGNED
}

enum DepositRefundDecision {
  PENDING
  FULL
  PARTIAL
  WITHHOLD
}

enum RepairUrgency {
  LOW
  NORMAL
  HIGH
}

enum RepairStatus {
  TODO
  QUOTE_RECEIVED
  IN_PROGRESS
  DONE
}

model InspectionChecklistTemplate {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  unitKind       UnitKind? @map("unit_kind")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  items          InspectionChecklistTemplateItem[]

  @@index([organizationId])
  @@map("inspection_checklist_templates")
}

model InspectionChecklistTemplateItem {
  id         String   @id @default(uuid())
  templateId String   @map("template_id")
  template   InspectionChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  room       String   @db.VarChar(120)
  element    String   @db.VarChar(200)
  sortOrder  Int      @default(0) @map("sort_order")

  @@index([templateId])
  @@map("inspection_checklist_template_items")
}

model LeaseInspection {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaseId               String   @map("lease_id")
  lease                 Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  kind                  InspectionKind
  status                InspectionStatus @default(DRAFT)
  tenantSignatureName   String?  @map("tenant_signature_name") @db.VarChar(200)
  signedAt              DateTime? @map("signed_at")
  depositRefundDecision DepositRefundDecision? @map("deposit_refund_decision")
  depositRefundNote     String?  @map("deposit_refund_note") @db.VarChar(500)
  comparedMoveInId      String?  @map("compared_move_in_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  items                 LeaseInspectionItem[]
  photos                LeaseInspectionPhoto[]

  @@index([organizationId])
  @@index([leaseId])
  @@map("lease_inspections")
}

model LeaseInspectionItem {
  id           String   @id @default(uuid())
  inspectionId String   @map("inspection_id")
  inspection   LeaseInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  room         String   @db.VarChar(120)
  element      String   @db.VarChar(200)
  condition    InspectionItemCondition @default(UNCHECKED)
  note         String?  @db.VarChar(500)
  sortOrder    Int      @default(0) @map("sort_order")
  photos       LeaseInspectionPhoto[]

  @@index([inspectionId])
  @@map("lease_inspection_items")
}

model LeaseInspectionPhoto {
  id           String   @id @default(uuid())
  inspectionId String   @map("inspection_id")
  inspection   LeaseInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  itemId       String?  @map("item_id")
  item         LeaseInspectionItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  fileKey      String   @map("file_key")
  originalName String?  @map("original_name")
  mime         String
  size         Int
  caption      String?  @db.VarChar(300)
  takenAt      DateTime @default(now()) @map("taken_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([inspectionId])
  @@index([itemId])
  @@map("lease_inspection_photos")
}

model RepairRequest {
  id              String        @id @default(uuid())
  organizationId  String        @map("organization_id")
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buildingId      String        @map("building_id")
  building        Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId          String?       @map("unit_id")
  unit            Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  title           String        @db.VarChar(200)
  urgency         RepairUrgency @default(NORMAL)
  status          RepairStatus  @default(TODO)
  note            String?       @db.Text
  contractorName  String?       @map("contractor_name") @db.VarChar(200)
  contractorPhone String?       @map("contractor_phone") @db.VarChar(40)
  estimatedCost   Decimal?      @map("estimated_cost") @db.Decimal(12, 2)
  finalCost       Decimal?      @map("final_cost") @db.Decimal(12, 2)
  deadline        DateTime?     @db.Date
  completedAt     DateTime?     @map("completed_at")
  chargeId        String?       @unique @map("charge_id")
  charge          Charge?       @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  lateReminderAt  DateTime?     @map("late_reminder_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  photos          RepairPhoto[]

  @@index([organizationId])
  @@index([buildingId])
  @@index([status])
  @@map("repair_requests")
}

model RepairPhoto {
  id           String        @id @default(uuid())
  repairId     String        @map("repair_id")
  repair       RepairRequest @relation(fields: [repairId], references: [id], onDelete: Cascade)
  fileKey      String        @map("file_key")
  originalName String?       @map("original_name")
  mime         String
  size         Int
  caption      String?       @db.VarChar(300)
  takenAt      DateTime      @default(now()) @map("taken_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([repairId])
  @@map("repair_photos")
}
