{
  "meta": {
    "name": "MedCopilot Design System v2 (Generic)",
    "version": "2.0.0",
    "description": "Generic, component-agnostic design foundations + semantic tokens to build new components consistent with MedCopilot's visual language using Tailwind CSS.",
    "basedOn": "MedCopilot Design System v1 (extracted from existing components)",
    "goals": [
      "Abstract brand essence into reusable foundations",
      "Provide semantic tokens decoupled from specific views",
      "Define generic component contracts (sizes, variants, states)",
      "Enable light/dark modes and elevation system",
      "Map cleanly to Tailwind theme extension"
    ]
  },
  "tailwind": {
    "screens": { "sm": "480px", "md": "768px", "lg": "1024px", "xl": "1280px" },
    "theme": {
      "extend": {
        "colors": {
          "brand": {
            "primary": "#4361ee",
            "primary-600": "#3a56d4",
            "accent": "#7c3aed",
            "blue": "#3b82f6",
            "blue-800": "#1d4ed8",
            "purple": "#8b5cf6",
            "green": "#10b981",
            "orange": "#ea580c",
            "amber": "#fbbf24"
          },
          "neutral": {
            "50": "#fafbfc",
            "100": "#f8fafc",
            "200": "#f3f4f6",
            "300": "#e5e7eb",
            "400": "#d1d5db",
            "500": "#9ca3af",
            "600": "#6b7280",
            "700": "#475569",
            "800": "#374151",
            "900": "#1f2937"
          },
          "intent": {
            "success": "#10b981",
            "success-700": "#059669",
            "warning": "#f59e0b",
            "warning-200": "#fde68a",
            "danger": "#dc2626",
            "danger-200": "#fecaca",
            "info": "#3b82f6"
          }
        },
        "fontFamily": {
          "display": [
            "Inter",
            "-apple-system",
            "BlinkMacSystemFont",
            "Segoe UI",
            "system-ui",
            "sans-serif"
          ],
          "mono": [
            "SF Mono",
            "Monaco",
            "Cascadia Code",
            "Roboto Mono",
            "Consolas",
            "monospace"
          ]
        },
        "borderRadius": {
          "sm": "6px",
          "md": "8px",
          "lg": "12px",
          "xl": "16px",
          "2xl": "20px"
        },
        "boxShadow": {
          "subtle": "0 1px 3px 0 rgba(0,0,0,0.1), 0 1px 2px 0 rgba(0,0,0,0.06)",
          "soft": "0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06)",
          "elevated": "0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05)",
          "brand": "0 20px 25px -5px rgba(67,97,238,0.15), 0 10px 10px -5px rgba(67,97,238,0.04)"
        },
        "letterSpacing": {
          "tight-1": "-0.01em",
          "tight-2": "-0.02em",
          "tight-3": "-0.03em",
          "wide-1": "0.05em"
        },
        "transitionTimingFunction": { "swift": "cubic-bezier(0.4, 0, 0.2, 1)" },
        "transitionDuration": { "swift": "200ms", "smooth": "300ms" },
        "backgroundImage": {
          "gradient-primary": "linear-gradient(135deg, #4361ee, #3a56d4)",
          "gradient-accent": "linear-gradient(135deg, #7c3aed, #6366f1)",
          "gradient-success": "linear-gradient(90deg, #10b981, #34d399)",
          "gradient-warning": "linear-gradient(135deg, #f59e0b, #ea580c)",
          "gradient-danger": "linear-gradient(135deg, #f87171, #dc2626)"
        },
        "keyframes": {
          "fadeInUp": {
            "from": { "opacity": "0", "transform": "translateY(20px)" },
            "to": { "opacity": "1", "transform": "translateY(0)" }
          },
          "pulseCritical": {
            "0%": { "transform": "scale(1)" },
            "50%": { "transform": "scale(1.02)" },
            "100%": { "transform": "scale(1)" }
          },
          "pulseSoft": {
            "0%": { "opacity": "1" },
            "50%": { "opacity": "0.85" },
            "100%": { "opacity": "1" }
          },
          "spin": {
            "from": { "transform": "rotate(0deg)" },
            "to": { "transform": "rotate(360deg)" }
          }
        },
        "animation": {
          "fade-in-up": "fadeInUp 0.6s ease-out",
          "pulse-critical": "pulseCritical 1.25s infinite",
          "pulse-soft": "pulseSoft 1.5s infinite",
          "spin": "spin 1s linear infinite"
        }
      }
    }
  },
  "foundations": {
    "color": {
      "palette": { "$ref": "tailwind.theme.extend.colors" },
      "text": {
        "primary": "#1a1a1a",
        "secondary": "#4a5568",
        "tertiary": "#718096",
        "inverse": "#ffffff"
      },
      "surface": {
        "base": "#ffffff",
        "background": "#fafbfc",
        "muted": "#f8fafc",
        "elevated": "#ffffff"
      },
      "border": { "default": "#e2e8f0", "light": "#f1f5f9" }
    },
    "typography": {
      "families": {
        "display": { "$ref": "tailwind.theme.extend.fontFamily.display" },
        "mono": { "$ref": "tailwind.theme.extend.fontFamily.mono" }
      },
      "sizes": {
        "xs": "0.75rem",
        "sm": "0.8125rem",
        "base": "0.9375rem",
        "md": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.75rem",
        "4xl": "2rem",
        "5xl": "2.5rem"
      },
      "weights": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      },
      "lineHeights": {
        "tight": 1.1,
        "snug": 1.3,
        "normal": 1.5,
        "relaxed": 1.6
      },
      "letterSpacings": {
        "tight-1": "-0.01em",
        "tight-2": "-0.02em",
        "tight-3": "-0.03em",
        "wide-1": "0.05em"
      }
    },
    "spacing": {
      "0": "0px",
      "px": "1px",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "14": "3.5rem",
      "16": "4rem"
    },
    "radius": { "$ref": "tailwind.theme.extend.borderRadius" },
    "shadow": { "$ref": "tailwind.theme.extend.boxShadow" },
    "motion": {
      "duration": { "$ref": "tailwind.theme.extend.transitionDuration" },
      "easing": { "$ref": "tailwind.theme.extend.transitionTimingFunction" }
    },
    "zIndex": {
      "dropdown": 50,
      "sticky": 60,
      "overlay": 90,
      "modal": 100,
      "popover": 110,
      "tooltip": 120
    },
    "breakpoints": { "$ref": "tailwind.screens" }
  },
  "semantic": {
    "role": {
      "bg": {
        "default": "neutral.50",
        "muted": "neutral.100",
        "subtle": "neutral.200",
        "inverse": "brand.blue-800"
      },
      "text": {
        "default": "#1a1a1a",
        "muted": "#4a5568",
        "subtle": "#718096",
        "inverse": "#ffffff"
      },
      "border": {
        "default": "#e2e8f0",
        "muted": "#f1f5f9",
        "accent": "rgba(67,97,238,0.2)"
      }
    },
    "brand": { "primary": "brand.primary", "accent": "brand.accent" },
    "states": {
      "default": { "bg": "#ffffff", "text": "#1a1a1a", "border": "#e2e8f0" },
      "primary": {
        "bg": "#4361ee",
        "text": "#ffffff",
        "hoverBg": "#3a56d4",
        "ring": "rgba(67,97,238,0.3)"
      },
      "secondary": {
        "bg": "#f8fafc",
        "text": "#475569",
        "hoverBg": "#f1f5f9",
        "border": "#e2e8f0"
      },
      "muted": { "bg": "#f3f4f6", "text": "#6b7280" },
      "success": { "bg": "#10b981", "text": "#ffffff", "subtle": "#f0fdf4" },
      "warning": { "bg": "#f59e0b", "text": "#1f2937", "subtle": "#fff7ed" },
      "danger": { "bg": "#dc2626", "text": "#ffffff", "subtle": "#fef2f2" },
      "info": { "bg": "#3b82f6", "text": "#ffffff", "subtle": "#eff6ff" },
      "disabled": { "bg": "#f3f4f6", "text": "#9ca3af", "border": "#e5e7eb" }
    },
    "elevation": {
      "0": { "bg": "#ffffff", "shadow": "none", "border": "#e5e7eb" },
      "1": { "bg": "#ffffff", "shadow": "subtle", "border": "#f1f5f9" },
      "2": { "bg": "#ffffff", "shadow": "soft", "border": "#f1f5f9" },
      "3": { "bg": "#ffffff", "shadow": "elevated", "border": "#e5e7eb" },
      "brand": { "bg": "#ffffff", "shadow": "brand", "border": "#f1f5f9" }
    },
    "focusRing": { "color": "rgba(67,97,238,0.3)", "width": "3px" }
  },
  "components": {
    "button": {
      "contract": {
        "slots": ["root", "icon", "label"],
        "states": ["default", "hover", "active", "disabled", "focus"],
        "sizes": ["sm", "md", "lg"],
        "variants": [
          "primary",
          "secondary",
          "outline",
          "ghost",
          "subtle",
          "destructive",
          "link"
        ]
      },
      "sizes": {
        "sm": {
          "px": "0.75rem",
          "py": "0.5rem",
          "text": "0.8125rem",
          "radius": "md"
        },
        "md": {
          "px": "1rem",
          "py": "0.625rem",
          "text": "0.9375rem",
          "radius": "md"
        },
        "lg": {
          "px": "1.25rem",
          "py": "0.75rem",
          "text": "0.9375rem",
          "radius": "md"
        }
      },
      "variants": {
        "primary": {
          "bg": "states.primary.bg",
          "text": "states.primary.text",
          "hoverBg": "states.primary.hoverBg",
          "shadow": "soft"
        },
        "secondary": {
          "bg": "states.secondary.bg",
          "text": "states.secondary.text",
          "border": "states.secondary.border"
        },
        "outline": {
          "bg": "transparent",
          "text": "#475569",
          "border": "#e2e8f0",
          "hoverBg": "#f8fafc"
        },
        "ghost": {
          "bg": "transparent",
          "text": "#475569",
          "hoverBg": "rgba(67,97,238,0.1)",
          "hoverText": "#4361ee"
        },
        "subtle": { "bg": "#f3f4f6", "text": "#475569", "hoverBg": "#e5e7eb" },
        "destructive": {
          "bg": "states.danger.bg",
          "text": "states.danger.text",
          "hoverBg": "#b91c1c"
        },
        "link": { "bg": "transparent", "text": "#4361ee", "underline": true }
      }
    },
    "input": {
      "sizes": {
        "sm": { "h": "38px", "text": "0.875rem" },
        "md": { "h": "44px", "text": "0.9375rem" },
        "lg": { "h": "48px", "text": "1rem" }
      },
      "field": {
        "bg": "#ffffff",
        "border": "#e5e7eb",
        "radius": "xl",
        "placeholder": "#9ca3af",
        "focusBorder": "#2563eb",
        "focusRing": "rgba(37,99,235,0.1)"
      },
      "label": { "text": "#374151", "size": "0.875rem", "weight": 600 },
      "helpText": { "text": "#6b7280", "size": "0.8125rem" },
      "invalid": {
        "border": "#dc2626",
        "ring": "rgba(220,38,38,0.15)",
        "text": "#dc2626"
      }
    },
    "card": {
      "elevations": {
        "0": { "$ref": "semantic.elevation.0" },
        "1": { "$ref": "semantic.elevation.1" },
        "2": { "$ref": "semantic.elevation.2" },
        "3": { "$ref": "semantic.elevation.3" },
        "brand": { "$ref": "semantic.elevation.brand" }
      },
      "radius": "2xl",
      "padding": { "default": "1.5rem", "lg": "2rem" }
    },
    "badge": {
      "sizes": {
        "sm": { "px": "0.5rem", "py": "0.25rem", "text": "0.75rem" },
        "md": { "px": "0.625rem", "py": "0.375rem", "text": "0.8125rem" }
      },
      "variants": {
        "neutral": { "bg": "#f3f4f6", "text": "#475569", "border": "#e5e7eb" },
        "success": { "bg": "#f0fdf4", "text": "#059669", "border": "#bbf7d0" },
        "warning": { "bg": "#fff7ed", "text": "#9a3412", "border": "#fed7aa" },
        "danger": { "bg": "#fef2f2", "text": "#dc2626", "border": "#fecaca" },
        "info": { "bg": "#eff6ff", "text": "#1d4ed8", "border": "#bfdbfe" }
      }
    },
    "alert": {
      "variants": {
        "success": { "bg": "#f0fdf4", "border": "#bbf7d0", "text": "#065f46" },
        "warning": { "bg": "#fffbeb", "border": "#fde68a", "text": "#92400e" },
        "danger": { "bg": "#fef2f2", "border": "#fecaca", "text": "#991b1b" },
        "info": { "bg": "#eff6ff", "border": "#bfdbfe", "text": "#1e40af" }
      },
      "radius": "lg",
      "padding": "1rem"
    },
    "modal": {
      "overlay": { "bg": "rgba(0,0,0,0.6)", "backdrop": "blur(4px)", "z": 100 },
      "content": {
        "bg": "#ffffff",
        "radius": "2xl",
        "shadow": "elevated",
        "padding": "2rem",
        "maxWidth": "640px"
      },
      "header": {
        "title": { "size": "1.375rem", "weight": 600 },
        "desc": { "size": "0.9375rem", "color": "#6b7280" }
      }
    },
    "toast": {
      "z": 100,
      "base": {
        "bg": "#ffffff",
        "border": "#e5e7eb",
        "radius": "0.75rem",
        "shadow": "soft",
        "padding": "1rem 1.25rem"
      },
      "variants": {
        "success": { "bg": "#f0fdf4", "border": "#059669" },
        "error": { "bg": "#fef2f2", "border": "#dc2626" },
        "info": { "bg": "#eff6ff", "border": "#3b82f6" }
      }
    },
    "tabs": {
      "sizes": {
        "md": { "height": "40px", "gap": "0.5rem", "text": "0.9375rem" }
      },
      "variants": {
        "underline": {
          "activeColor": "#4361ee",
          "inactiveColor": "#6b7280",
          "indicatorHeight": "2px"
        },
        "pill": {
          "activeBg": "#4361ee",
          "activeText": "#ffffff",
          "inactiveText": "#4a5568",
          "hoverBg": "rgba(67,97,238,0.1)"
        }
      }
    },
    "table": {
      "header": { "bg": "#f8fafc", "text": "#475569", "border": "#e5e7eb" },
      "row": { "hoverBg": "#f8fafc", "border": "#f1f5f9" },
      "cell": { "padding": "0.75rem 1rem", "text": "#374151" },
      "radius": "lg"
    },
    "tooltip": {
      "bg": "#1f2937",
      "text": "#ffffff",
      "radius": "6px",
      "padding": "0.375rem 0.5rem",
      "shadow": "subtle"
    }
  },
  "recipes": {
    "primaryCTA": {
      "component": "button",
      "variant": "primary",
      "size": "lg",
      "elevation": "brand"
    },
    "subtleCard": {
      "component": "card",
      "elevation": "1",
      "radius": "lg",
      "padding": "1.5rem"
    },
    "dangerAction": {
      "component": "button",
      "variant": "destructive",
      "size": "md"
    },
    "inlineTag": { "component": "badge", "variant": "neutral", "size": "sm" }
  }
}
