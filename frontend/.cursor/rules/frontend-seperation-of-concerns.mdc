### 6. Utils Layer (`utils/{module}/`)

**SOLE RESPONSIBILITY**: Pure functions for transformations and calculations

#### ✅ ALLOWED
```tsx
// utils/transaction/transactionTransformers.ts

/**
 * Transforms API response to UI Transaction type
 */
export function transformTransactionFromApi(
  apiData: TransactionApiResponse
): Transaction {
  return {
    id: apiData.id,
    reference: apiData.reference,
    amount: apiData.amount_cents / 100, // cents to euros
    currency: apiData.currency as Currency,
    date: new Date(apiData.transaction_date),
    status: apiData.status.toLowerCase() as TransactionStatus,
    customerId: apiData.customer_id,
    customerName: apiData.customer_name,
    description: apiData.description,
    createdAt: new Date(apiData.created_at),
    updatedAt: new Date(apiData.updated_at)
  }
}

/**
 * Transforms Transaction for CSV export
 */
export function transformTransactionForExport(transaction: Transaction) {
  return {
    Reference: transaction.reference,
    Date: formatDate(transaction.date, 'YYYY-MM-DD'),
    Amount: transaction.amount.toFixed(2),
    Currency: transaction.currency,
    Customer: transaction.customerName || transaction.customerId,
    Status: transaction.status,
    Description: transaction.description || ''
  }
}

/**
 * Calculates transaction totals by currency
 */
export function calculateTransactionTotals(
  transactions: Transaction[]
): Record<Currency, number> {
  return transactions.reduce((acc, t) => {
    acc[t.currency] = (acc[t.currency] || 0) + t.amount
    return acc
  }, {} as Record<Currency, number>)
}

/**
 * Groups transactions by month
 */
export function groupTransactionsByMonth(
  transactions: Transaction[]
): Record<string, Transaction[]> {
  return transactions.reduce((acc, transaction) => {
    const monthKey = format(transaction.date, 'yyyy-MM')
    if (!acc[monthKey]) acc[monthKey] = []
    acc[monthKey].push(transaction)
    return acc
  }, {} as Record<string, Transaction[]>)
}

/**
 * Validates transaction amount is within limits
 */
export function isTransactionAmountValid(
  amount: number,
  currency: Currency
): boolean {
  const limits = {
    EUR: { min: 0.01, max: 1000000 },
    USD: { min: 0.01, max: 1000000 },
    GBP: { min: 0.01, max: 1000000 },
    XOF: { min: 1, max: 100000000 }
  }
  
  const { min, max } = limits[currency]
  return amount >= min && amount <= max
}
```

