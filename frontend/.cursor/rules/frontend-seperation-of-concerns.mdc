### 8. Store Layer (`store/slices/`)

**SOLE RESPONSIBILITY**: Global state management

#### ✅ ALLOWED (Redux Toolkit)
```tsx
// store/slices/transactionSlice.ts
import { createSlice, PayloadAction } from '@reduxjs/toolkit'
import type { Transaction, TransactionFilters } from '@/types/transaction.types'

interface TransactionState {
  selectedIds: string[]
  filters: TransactionFilters
  viewMode: 'table' | 'cards' | 'calendar'
  bulkActionMode: boolean
}

const initialState: TransactionState = {
  selectedIds: [],
  filters: DEFAULT_TRANSACTION_FILTERS,
  viewMode: 'table',
  bulkActionMode: false
}

const transactionSlice = createSlice({
  name: 'transaction',
  initialState,
  reducers: {
    setSelectedIds: (state, action: PayloadAction<string[]>) => {
      state.selectedIds = action.payload
    },
    toggleSelection: (state, action: PayloadAction<string>) => {
      const id = action.payload
      const index = state.selectedIds.indexOf(id)
      if (index > -1) {
        state.selectedIds.splice(index, 1)
      } else {
        state.selectedIds.push(id)
      }
    },
    clearSelection: (state) => {
      state.selectedIds = []
    },
    setFilters: (state, action: PayloadAction<TransactionFilters>) => {
      state.filters = action.payload
    },
    setViewMode: (state, action: PayloadAction<'table' | 'cards' | 'calendar'>) => {
      state.viewMode = action.payload
    },
    toggleBulkActionMode: (state) => {
      state.bulkActionMode = !state.bulkActionMode
      if (!state.bulkActionMode) {
        state.selectedIds = []
      }
    }
  }
})

export const {
  setSelectedIds,
  toggleSelection,
  clearSelection,
  setFilters,
  setViewMode,
  toggleBulkActionMode
} = transactionSlice.actions

export default transactionSlice.reducer

// Selectors
export const selectSelectedIds = (state: RootState) => state.transaction.selectedIds
export const selectFilters = (state: RootState) => state.transaction.filters
export const selectViewMode = (state: RootState) => state.transaction.viewMode
export const selectBulkActionMode = (state: RootState) => state.transaction.bulkActionMode
export const selectHasSelection = (state: RootState) => state.transaction.selectedIds.length > 0
```

#### ✅ ALLOWED (Zustand)
```tsx
// store/useTransactionStore.ts
import { create } from 'zustand'
import { persist } from 'zustand/middleware'

interface TransactionStore {
  selectedIds: string[]
  filters: TransactionFilters
  viewMode: 'table' | 'cards' | 'calendar'
  bulkActionMode: boolean
  
  // Actions
  setSelectedIds: (ids: string[]) => void
  toggleSelection: (id: string) => void
  clearSelection: () => void
  setFilters: (filters: TransactionFilters) => void
  setViewMode: (mode: 'table' | 'cards' | 'calendar') => void
  toggleBulkActionMode: () => void
}

export const useTransactionStore = create<TransactionStore>()(
  persist(
    (set, get) => ({
      selectedIds: [],
      filters: DEFAULT_TRANSACTION_FILTERS,
      viewMode: 'table',
      bulkActionMode: false,
      
      setSelectedIds: (ids) => set({ selectedIds: ids }),
      
      toggleSelection: (id) => set((state) => {
        const index = state.selectedIds.indexOf(id)
        const newIds = [...state.selectedIds]
        if (index > -1) {
          newIds.splice(index, 1)
        } else {
          newIds.push(id)
        }
        return { selectedIds: newIds }
      }),
      
      clearSelection: () => set({ selectedIds: [] }),
      
      setFilters: (filters) => set({ filters }),
      
      setViewMode: (mode) => set({ viewMode: mode }),
      
      toggleBulkActionMode: () => set((state) => ({
        bulkActionMode: !state.bulkActionMode,
        selectedIds: !state.bulkActionMode ? [] : state.selectedIds
      }))
    }),
    {
      name: 'transaction-storage',
      partialize: (state) => ({ 
        viewMode: state.viewMode,
        filters: state.filters 
      })
    }
  )
)
```

**RULES**:
- ✅ Global UI state ONLY
- ✅ Cross-component state
- ✅ User preferences
- ✅ Selection state
- ✅ View modes
- ❌ NO API data (use React Query)
- ❌ NO derived state (use selectors)
- ❌ NO business logic (use hooks)

