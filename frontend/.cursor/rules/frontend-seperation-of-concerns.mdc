### 4. Services Layer (`services/`)

**SOLE RESPONSIBILITY**: API communication ONLY

#### ✅ ALLOWED
```tsx
// services/transactionService.ts
import { apiClient } from './api.config'
import type { 
  Transaction, 
  TransactionApiResponse,
  CreateTransactionPayload,
  UpdateTransactionPayload,
  TransactionFilters 
} from '@/types/transaction.types'

/**
 * Transaction API service
 * Handles all HTTP requests for transaction domain
 */
export const transactionService = {
  /**
   * Fetches list of transactions with optional filters
   */
  list: async (filters?: TransactionFilters): Promise<Transaction[]> => {
    const { data } = await apiClient.get<{ items: TransactionApiResponse[] }>(
      '/transactions',
      { params: filters }
    )
    return data.items.map(transformTransactionFromApi)
  },
  
  /**
   * Fetches a single transaction by ID
   */
  getById: async (id: string): Promise<Transaction> => {
    const { data } = await apiClient.get<TransactionApiResponse>(`/transactions/${id}`)
    return transformTransactionFromApi(data)
  },
  
  /**
   * Creates a new transaction
   */
  create: async (payload: CreateTransactionPayload): Promise<Transaction> => {
    const apiPayload = transformTransactionToApi(payload)
    const { data } = await apiClient.post<TransactionApiResponse>(
      '/transactions',
      apiPayload
    )
    return transformTransactionFromApi(data)
  },
  
  /**
   * Updates an existing transaction
   */
  update: async (id: string, payload: UpdateTransactionPayload): Promise<Transaction> => {
    const apiPayload = transformTransactionToApi(payload)
    const { data } = await apiClient.put<TransactionApiResponse>(
      `/transactions/${id}`,
      apiPayload
    )
    return transformTransactionFromApi(data)
  },
  
  /**
   * Deletes a transaction
   */
  delete: async (id: string): Promise<void> => {
    await apiClient.delete(`/transactions/${id}`)
  },
  
  /**
   * Validates a transaction
   */
  validate: async (id: string): Promise<Transaction> => {
    const { data } = await apiClient.post<TransactionApiResponse>(
      `/transactions/${id}/validate`
    )
    return transformTransactionFromApi(data)
  },
  
  /**
   * Exports transactions to CSV
   */
  export: async (filters?: TransactionFilters): Promise<Blob> => {
    const { data } = await apiClient.get('/transactions/export', {
      params: filters,
      responseType: 'blob'
    })
    return data
  }
}

// Private helper for API transformation (could be in utils)
function transformTransactionToApi(transaction: Partial<Transaction>): any {
  return {
    reference: transaction.reference,
    amount_cents: transaction.amount ? Math.round(transaction.amount * 100) : undefined,
    currency: transaction.currency,
    transaction_date: transaction.date?.toISOString(),
    status: transaction.status?.toUpperCase(),
    customer_id: transaction.customerId,
    description: transaction.description
  }
}
```

**RULES**:
- ✅ HTTP requests ONLY
- ✅ JSDoc documentation for each function
- ✅ Proper TypeScript types
- ✅ Transform data using utils (or minimal inline)
- ✅ Return typed data
- ❌ NO business logic
- ❌ NO UI state management
- ❌ NO complex transformations (delegate to utils)
- ❌ NO caching logic (React Query handles it)
- ❌ NO retry logic (axios interceptor handles it)

