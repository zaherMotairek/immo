## Testing Strategy by Layer

### Components
```tsx
// Test props and rendering
test('TransactionCard renders transaction data', () => {
  const transaction = createMockTransaction()
  render(<TransactionCard transaction={transaction} />)
  expect(screen.getByText(transaction.reference)).toBeInTheDocument()
})
```

### Hooks
```tsx
// Test logic and state changes
test('useTransactionList filters transactions', () => {
  const { result } = renderHook(() => useTransactionList())
  act(() => result.current.handleSearch('TRX-001'))
  expect(result.current.transactions).toHaveLength(1)
})
```

### Utils
```tsx
// Test pure functions
test('transformTransactionFromApi converts correctly', () => {
  const apiData = createMockApiResponse()
  const result = transformTransactionFromApi(apiData)
  expect(result.amount).toBe(apiData.amount_cents / 100)
})
```

### Services
```tsx
// Test API calls with MSW
test('transactionService.list fetches transactions', async () => {
  const transactions = await transactionService.list()
  expect(transactions).toHaveLength(2)
})
