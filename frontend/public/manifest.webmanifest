{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "ImmoPilot — Gestion locative",
  "short_name": "ImmoPilot",
  "description": "Pilotage locatif : parc, baux, loyers, charges, impayés, PDF et recherche — interface pro pour la Côte d’Ivoire.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#0f172a",
  "lang": "fr",
  "scope": "/",
  "id": "/",
  "orientation": "any",
  "dir": "ltr",
  "icons": [
    {
      "src": "/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
