    "react-router-dom": "^7.6.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.7.2",
