{
  "name": "immopilot",
  "private": true,
  "version": "1.0.0",
  "description": "ImmoPilot — monorepo (frontend React + backend NestJS)",
  "scripts": {
    "check": "npm run check:frontend && npm run check:backend && npm run test",
    "check:frontend": "npm --prefix frontend run check",
    "check:backend": "npm --prefix backend run typecheck && npm --prefix backend run build",
    "check:visual": "npm --prefix frontend run check:visual",
    "check:visual:compare": "npm --prefix frontend run e2e:visual:compare",
    "test": "npm --prefix backend run test",
    "seed": "npm --prefix backend run seed",
    "assert-local-db": "node scripts/assert-local-db.mjs"
  }
}
